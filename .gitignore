# --- Private / secrets (never commit) ---
PRIVATE_CONTEXT.md
.env
.env.*
!.env.example

# --- Data ---
# Raw data is gitignored by default (see CLAUDE.md §7).
data/raw/*
!data/raw/.gitkeep
# Intermediate pipeline outputs (clipped rasters, grids)
data/interim/*
!data/interim/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Notebooks (jupytext .py is the source of truth) ---
.ipynb_checkpoints/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
